{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "klips",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // klips.pro and www.klips.pro serve this Worker. Cloudflare creates the DNS records and certificates.
  "routes": [
    { "pattern": "klips.pro", "custom_domain": true },
    { "pattern": "www.klips.pro", "custom_domain": true }
  ],
  // Keep the workers.dev address too: the Stripe webhook may point at it.
  "workers_dev": true,

  // The React site is served from the same Worker; /api/* runs the Worker code first.
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/download/*", "/media/*"]
  },

  // Create with:  npx wrangler d1 create klips     then paste the id below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "klips",
      "database_id": "bb68c3d5-7115-41d8-b55e-1f2e6e791db0"
    }
  ],

  "vars": {
    // Where Stripe sends customers back after checkout.
    "SITE_URL": "https://klips.pro"
  },

  // Installers built by GitHub Actions. The repo is private, so scripts/sync.sh copies each
  // release here and /download/mac and /download/windows serve the files from this bucket.
  "r2_buckets": [
    {
      "binding": "DOWNLOADS",
      "bucket_name": "klips-downloads"
    }
  ]

  // Secrets (set with `npx wrangler secret put NAME`, never committed):
  //   STRIPE_SECRET_KEY        sk_live_... / sk_test_...
  //   STRIPE_WEBHOOK_SECRET    whsec_...
}
