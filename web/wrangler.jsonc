{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "klips",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // The React site is served from the same Worker; /api/* runs the Worker code first.
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/download/*"]
  },

  // Create with:  npx wrangler d1 create klips     then paste the id below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "klips",
      "database_id": "bb68c3d5-7115-41d8-b55e-1f2e6e791db0"
    }
  ],

  "vars": {
    // Where Stripe sends customers back after checkout. Switch to https://klips.pro once the domain is connected.
    "SITE_URL": "https://klips.kcd-ryanc.workers.dev",
    // Point these at the installers once the first release is published on GitHub.
    "DOWNLOAD_MAC_URL": "https://github.com/YOUR_GITHUB_USERNAME/klips/releases/latest/download/Klips-mac.dmg",
    "DOWNLOAD_WINDOWS_URL": "https://github.com/YOUR_GITHUB_USERNAME/klips/releases/latest/download/Klips-windows.exe"
  }

  // Secrets (set with `npx wrangler secret put NAME`, never committed):
  //   STRIPE_SECRET_KEY        sk_live_... / sk_test_...
  //   STRIPE_WEBHOOK_SECRET    whsec_...
}
